<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Citizen Dashboard - Barangay Emergency Response</title>
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="dashboard">
        <aside class="sidebar">
            <div class="sidebar-header">
                <h3><i class="fas fa-shield-alt"></i> Emergency System</h3>
            </div>
            <ul class="sidebar-menu">
                <li><a href="citizen-dashboard.html" class="active"><i class="fas fa-home"></i> Dashboard</a></li>
                <li><a href="report-emergency.html"><i class="fas fa-exclamation-triangle"></i> Report Emergency</a></li>
                <li><a href="my-emergencies.html"><i class="fas fa-list"></i> My Emergencies</a></li>
                <li><a href="emergency-contacts.html"><i class="fas fa-phone"></i> Emergency Contacts</a></li>
                <li><a href="#" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
            </ul>
        </aside>

        <main class="main-content">
            <div class="topbar">
                <h2>Citizen Dashboard</h2>
                <div class="user-menu">
                    <span id="userName">Loading...</span>
                    <div class="user-avatar" id="userAvatar">C</div>
                </div>
            </div>

            <div class="content">
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon primary">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="stat-details">
                            <h3 id="totalEmergencies">0</h3>
                            <p>Total Emergencies</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon warning">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="stat-details">
                            <h3 id="pendingEmergencies">0</h3>
                            <p>Pending</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon secondary">
                            <i class="fas fa-ambulance"></i>
                        </div>
                        <div class="stat-details">
                            <h3 id="respondingEmergencies">0</h3>
                            <p>Responding</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon success">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="stat-details">
                            <h3 id="resolvedEmergencies">0</h3>
                            <p>Resolved</p>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h3>Recent Emergencies</h3>
                        <a href="report-emergency.html" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Report Emergency
                        </a>
                    </div>
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Type</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Priority</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="emergenciesTableBody">
                                <tr>
                                    <td colspan="7" class="text-center">Loading...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h3>Quick Emergency Contacts</h3>
                    </div>
                    <div id="contactsContainer" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
                        <!-- Contacts will be loaded here -->
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Emergency Details Modal -->
    <div id="emergencyModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Emergency Details</h3>
                <button class="close-modal" onclick="closeModal()">&times;</button>
            </div>
            <div class="modal-body" id="emergencyDetails">
                <!-- Details will be loaded here -->
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeModal()">Close</button>
            </div>
        </div>
    </div>

    <script src="js/app.js"></script>
    <script>
        // Check authentication
        if (!requireAuth()) {
            throw new Error('Not authenticated');
        }

        const user = getCurrentUser();

        // Initialize dashboard
        function initDashboard() {
            // Update user info
            document.getElementById('userName').textContent = `${user.firstName} ${user.lastName}`;
            document.getElementById('userAvatar').textContent = user.firstName.charAt(0).toUpperCase();

            // Load data
            loadEmergencies();
            loadContacts();
        }

        function loadEmergencies() {
            const emergencies = getEmergencies();
            
            // Update stats
            document.getElementById('totalEmergencies').textContent = emergencies.length;
            document.getElementById('pendingEmergencies').textContent = 
                emergencies.filter(e => e.status === 'pending').length;
            document.getElementById('respondingEmergencies').textContent = 
                emergencies.filter(e => e.status === 'responding' || e.status === 'acknowledged').length;
            document.getElementById('resolvedEmergencies').textContent = 
                emergencies.filter(e => e.status === 'resolved').length;

            // Update table
            const tbody = document.getElementById('emergenciesTableBody');
            
            if (emergencies.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center">No emergencies reported yet. <a href="report-emergency.html">Report one now</a></td></tr>';
                return;
            }

            tbody.innerHTML = emergencies.slice(0, 10).map(emergency => `
                <tr>
                    <td>#${emergency.id}</td>
                    <td>${emergency.typeName || 'N/A'}</td>
                    <td>${emergency.title}</td>
                    <td><span class="badge ${getStatusBadge(emergency.status)}">${emergency.status}</span></td>
                    <td><span class="badge ${getPriorityBadge(emergency.priority)}">${emergency.priority}</span></td>
                    <td>${formatDate(emergency.createdAt)}</td>
                    <td>
                        <button class="btn btn-secondary" onclick="viewEmergency(${emergency.id})">
                            <i class="fas fa-eye"></i>
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        function loadContacts() {
            const contacts = JSON.parse(localStorage.getItem('emergencyContacts') || '[]');
            const container = document.getElementById('contactsContainer');
            
            if (contacts.length === 0) {
                container.innerHTML = '<p class="text-center">No contacts available</p>';
                return;
            }

            container.innerHTML = contacts.slice(0, 4).map(contact => `
                <div style="background: white; padding: 15px; border-radius: 8px; text-align: center; box-shadow: var(--box-shadow);">
                    <i class="fas fa-phone" style="font-size: 2rem; color: var(--primary-color); margin-bottom: 10px;"></i>
                    <h4 style="margin-bottom: 5px;">${contact.name}</h4>
                    <p style="color: var(--secondary-color); font-weight: bold;">${contact.phone}</p>
                    <a href="tel:${contact.phone}" class="btn btn-primary" style="margin-top: 10px;">Call Now</a>
                </div>
            `).join('');
        }

        function viewEmergency(id) {
            const emergency = getEmergencyById(id);
            if (!emergency) return;

            const detailsHtml = `
                <div style="margin-bottom: 20px;">
                    <h4>${emergency.title}</h4>
                    <p><strong>Type:</strong> ${emergency.typeName}</p>
                    <p><strong>Status:</strong> <span class="badge ${getStatusBadge(emergency.status)}">${emergency.status}</span></p>
                    <p><strong>Priority:</strong> <span class="badge ${getPriorityBadge(emergency.priority)}">${emergency.priority}</span></p>
                    <p><strong>Description:</strong> ${emergency.description || 'N/A'}</p>
                    <p><strong>Location:</strong> ${emergency.address || 'N/A'}</p>
                    <p><strong>Reported:</strong> ${formatDate(emergency.createdAt)}</p>
                    ${emergency.assignedResponderName ? `<p><strong>Responder:</strong> ${emergency.assignedResponderName}</p>` : '<p><strong>Status:</strong> Waiting for responder assignment</p>'}
                    ${emergency.resolvedAt ? `<p><strong>Resolved:</strong> ${formatDate(emergency.resolvedAt)}</p>` : ''}
                </div>
                ${emergency.updates && emergency.updates.length > 0 ? `
                    <div>
                        <h4>Updates</h4>
                        ${emergency.updates.map(update => `
                            <div style="background: #f8f9fa; padding: 10px; margin-bottom: 10px; border-radius: 5px;">
                                <p style="margin: 0;"><strong>${update.userName}</strong> - ${formatDate(update.timestamp)}</p>
                                <p style="margin: 5px 0 0;">${update.message}</p>
                            </div>
                        `).join('')}
                    </div>
                ` : ''}
            `;

            document.getElementById('emergencyDetails').innerHTML = detailsHtml;
            document.getElementById('emergencyModal').classList.add('active');
        }

        function closeModal() {
            document.getElementById('emergencyModal').classList.remove('active');
        }

        // Initialize on page load
        initDashboard();

        // Refresh every 30 seconds
        setInterval(loadEmergencies, 30000);
    </script>
</body>
</html>
